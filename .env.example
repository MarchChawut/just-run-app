# Database — MariaDB บน Synology NAS
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# NextAuth v5 — ใช้ AUTH_SECRET (ไม่ใช่ NEXTAUTH_SECRET)
# สร้างด้วย: openssl rand -base64 32
AUTH_SECRET=""

# URL ของแอป — เปลี่ยนเป็น https://your-domain.com สำหรับ production
NEXTAUTH_URL="http://localhost:3000"

# Self-host หลัง reverse proxy: ตั้ง true บน production (โค้ดตั้ง trustHost:true ไว้แล้ว
# บรรทัดนี้เป็น fallback/เอกสารกำกับ — กัน UntrustedHost ตอน sign-in)
AUTH_TRUST_HOST="true"

# Google OAuth (จาก console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admin access — comma-separated emails ที่เข้า /admin ได้
ADMIN_EMAILS="chawut.sa@gmail.com"
